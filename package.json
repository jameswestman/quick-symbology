{
  "name": "quick-symbology",
  "version": "0.1.0",
  "description": "Quick, data-driven symbology for your MapLibre maps",
  "repository": {
    "type": "git",
    "url": "https://github.com/jameswestman/quick-symbology.git"
  },
  "type": "module",
  "main": "./dist/quick-symbology.js",
  "types": "./dist/quick-symbology.d.ts",
  "exports": {
    ".": {
      "types": "./dist/quick-symbology.d.ts",
      "import": "./dist/quick-symbology.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "docs": "npm run build && tsc -p ./scripts/tsconfig.json && node ./scripts/generate-docs.js"
  },
  "keywords": [
    "cartography",
    "geography",
    "gis",
    "maps",
    "maplibre",
    "symbology"
  ],
  "author": "James Westman <james@jwestman.net>",
  "license": "MIT",
  "peerDependencies": {
    "maplibre-gl": "^6.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@types/node": "^26.6.6",
    "maplibre-gl": "^6.16.0",
    "typescript": "^7.0.2"
  }
}
